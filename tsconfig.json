{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "noUncheckedSideEffectImports": false,
        "noImplicitAny": true
    },
    "include": ["src/**/*"]
}